
<h1>Search Results</h1>

<h3>Results for: <%= q %></h3>

<% if (results.length === 0) { %>

    <p>No comments found!</p>

<% } %>

<% for (let comment of results) { %>

    <div>
        <h3><%= comment.username %></h3>

        <p><%= comment.comment %></p>

        <a href="/comments/<%= comment.id %>">
            View Comment
        </a>

        <a href="/comments/<%= comment.id %>/edit">
            Edit
        </a>
    </div>



<% } %>

<a href="/comments">Back to Comments</a>
